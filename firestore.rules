rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /inspections/{inspectionId} {
      allow read, write: if true;
    }
    match /cases/{caseId} {
      allow read, write: if true;
    }
    match /communityReports/{reportId} {
      allow read, write: if true;
    }
    match /logistics/{logisticsId} {
      allow read, write: if true;
    }
  }
}
